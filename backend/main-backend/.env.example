PORT=5000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth app (optional, only for "Sign in with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI: used by every agent, the workflow generator and chat memory embeddings
OPENAI_API_KEY=sk-...

# Long random strings. Generate with: openssl rand -hex 32
JWT_SECRET=
# Must be exactly 64 hex characters (32 bytes, AES-256-GCM). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Matches backend/docker/docker-compose.yml
MONGODB_URL=mongodb://127.0.0.1:27018/gopilot
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
